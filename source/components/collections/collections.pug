mixin film-card(film)
  article.card
    .frame
      img.poster(
        src=film.poster
        alt=`Постер фильма «${film.title}»`
        loading="lazy"
      )

      .over
        p= film.description

      button.heart(
        type="button"
        data-id=film.id
        aria-pressed="false"
        aria-label=`Добавить «${film.title}» в избранное`
      )
        svg(viewBox="0 0 24 24")
          path(d="M12 21s-8-5.2-8-11a4.6 4.6 0 0 1 8-3 4.6 4.6 0 0 1 8 3c0 5.8-8 11-8 11z")

    h4= film.title

    .sm
      span= `${film.year}, ${film.genre}`
      b= `★ ${film.rating}`

section#collections
  .wrap
    .head
      h2 В тренде сегодня
      p.sub Что смотрит клуб прямо сейчас.

    .rail#rail(tabindex="0")
      each film in films
        +film-card(film)
