
doctype html
html(lang="ru")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")

    title MOVIE NIGHT — подборка фильмов для идеального вечера

    meta(
      name="description"
      content="Не знаете, что посмотреть сегодня? MOVIE NIGHT поможет выбрать фильм по жанру и настроению. Открывайте подборки, сохраняйте любимое и находите кино для своего вечера."
    )

    meta(name="theme-color" content="#0a0a0a")

    meta(property="og:type" content="website")
    meta(property="og:title" content="MOVIE NIGHT — кино для твоего вечера")
    meta(property="og:description" content="Выбирай фильм по настроению, открывай подборки и сохраняй любимое.")
    meta(property="og:url" content="https://riarain.github.io/MovieNight/")
    meta(property="og:image" content="https://riarain.github.io/MovieNight/assets/images/preview-2.webp")

    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)

    link(
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Onest:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    )
    link(rel="icon" type="image/png" href="/MovieNight/assets/favicon.png")

  body
    include ../header/header.pug
    block content
