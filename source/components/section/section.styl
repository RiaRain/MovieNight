section
  padding 120px 0

.head
  display flex
  justify-content space-between
  align-items flex-end
  gap 30px
  margin-bottom 56px
  flex-wrap wrap

h2
  font 400 clamp(32px, 4.8vw, 64px)/1.05 var(--serif)
  letter-spacing -.015em

.sub
  color var(--gray)
  max-width 300px
  font-size 15px

.roulette
  background var(--bg2)
  border-block 1px solid var(--line)

.filters
  display grid
  grid-template-columns repeat(3, 1fr)
  gap 48px
  margin-bottom 56px

  h3
    font italic 400 20px var(--serif)
    color var(--gray)
    margin-bottom 18px
    padding-bottom 12px
    border-bottom 1px solid var(--line)

.chips
  display flex
  flex-wrap wrap
  gap 8px

.chip
  padding 8px 15px
  font-size 14px
  border 1px solid var(--line)
  color #c9c5bd
  transition .25s

  &:hover
    border-color var(--ivory)
    color var(--ivory)

  &[aria-pressed=true]
    background var(--red)
    border-color var(--red)
    color var(--ivory)

.surprise
  display flex
  align-items center
  gap 28px
  flex-wrap wrap

  button.go
    position relative
    padding 26px 64px
    background var(--red)
    font 700 16px var(--serif)
    letter-spacing .2em
    color var(--ivory)
    transition .4s
    box-shadow 0 0 0 0 rgba(168, 50, 70, .5)
    animation pulse 2.6s infinite

    &::before, &::after
      content ''
      position absolute
      top 0
      bottom 0
      width 10px
      background repeating-linear-gradient(180deg, var(--bg2) 0 6px, transparent 6px 14px)

    &::before
      left 8px

    &::after
      right 8px

    &:hover
      transform translateY(-3px)
      background #c13d54
      letter-spacing .26em

    &:disabled
      animation none
      opacity .7
      cursor wait

@keyframes pulse
  70%
    box-shadow 0 0 0 22px rgba(168, 50, 70, 0)
  100%
    box-shadow 0 0 0 0 rgba(168, 50, 70, 0)

.hint
  color var(--gray)
  font-size 14px