.logo
  color inherit
  text-decoration none
#logoIcon
  display contents
header
  position sticky
  top 0
  z-index 50
  background rgba(17, 17, 17, .82)
  backdrop-filter blur(14px)
  border-bottom 1px solid var(--line)

.bar
  display flex
  align-items center
  justify-content space-between
  height 68px

.logo
  display flex
  align-items center
  gap 12px
  font 700 19px var(--serif)
  letter-spacing .22em

  svg
    width 26px
    height 26px
    color var(--red)

nav
  display flex
  gap 36px

  a
    color var(--gray)
    text-decoration none
    font-size 14px
    letter-spacing .06em
    position relative
    padding 4px 0
    transition color .3s

    &:hover
      color var(--ivory)

    &::after
      content ''
      position absolute
      left 0
      bottom -2px
      height 1px
      width 100%
      background var(--ivory)
      transform scaleX(0)
      transform-origin left
      transition transform .4s

    &:hover::after
      transform scaleX(1)

  .count
    display inline-block
    min-width 20px
    margin-left 6px
    padding 0 6px
    font-size 11px
    background var(--red)
    color var(--ivory)
    text-align center

.burger
  display none
  width 40px
  height 40px
  position relative

  i
    position absolute
    left 8px
    right 8px
    height 1px
    background var(--ivory)
    transition .3s

    &:nth-child(1)
      top 14px

    &:nth-child(2)
      top 25px

  &.on
    i
      &:nth-child(1)
        top 20px
        transform rotate(45deg)

      &:nth-child(2)
        top 20px
        transform rotate(-45deg)
